# Local secrets and machine-specific config
.env
.env.*
!.env.example
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Node / frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs, runtime state, and generated reports
logs/
locks/
reports/
agent/eval/reports/
work/
.cache/
runtime_cache/
backups/
archive/
env_snapshots/
*.log
*.out.log
*.err.log
*.pid

# Raw news corpora (经济日报 CSV / 人民日报 xlsx / 新闻联播 zip, several GB). Never commit.
backend/data/raw/
# Corpora derived from backend/data/raw by backend/scripts/build_econ_corpus.py (rebuildable).
backend/data/processed/

# Local databases, dumps, and generated data
*.db
*.sqlite
*.sqlite3
*.db-journal
*.dump
*.bak
*.sql.gz
*.tar
*.tar.gz
*.zip

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Private keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx

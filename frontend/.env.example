# Copy this file to .env for local frontend development.
# Do not put model, database, or API provider secrets in frontend env files.

VITE_API_BASE_URL=http://127.0.0.1:8030
# 远程打开页面（VS Code 端口转发、手机或其他电脑）时改为留空：VITE_API_BASE_URL=
# 前端会请求同源 /api，由开发服务器转发到 VITE_DEV_PROXY_TARGET（默认 http://127.0.0.1:8030）。
